# Mainnet only: NEAR Intents (1Click) and PAJ production have no testnet.
NEAR_RPC_URL=https://free.rpc.fastnear.com

# Optional 1Click partner JWT (partners.near-intents.org): drops the swap fee from 0.25% to ~0.2%
ONECLICK_JWT=

# PAJ Cash business API key (production) — never commit the real value
PAJ_API_KEY=
PAJ_API_URL=https://api.paj.cash

# Safety switch. false = sign-in, banks, name lookup and quotes are real, but no PAJ order is
# created and the wallet is never asked to send funds. true = REAL MONEY MOVES.
LIVE_ORDERS=false

# Paya's fee as % of the USDC amount (charged through PAJ's businessUSDCFee)
FEE_PERCENT=0.5

# Public https URL of this relay, for PAJ webhooks (optional; the relay also polls)
# PUBLIC_URL=https://relay.example.com

PORT=8787
DB_PATH=./paya.db
POLL_MS=5000
CORS_ORIGINS=http://localhost:3000

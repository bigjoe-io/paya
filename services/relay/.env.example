# ---- NEAR ----
# testnet while developing; mainnet for the real flow (1Click and the payout rail are mainnet/production only)
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
# the factory contract (paya.testnet / paya.near)
FACTORY_ACCOUNT_ID=paya-demo.testnet
# the operator account + a key that can call the factory and the deposit accounts
OPERATOR_ACCOUNT_ID=operator.paya-demo.testnet
OPERATOR_PRIVATE_KEY=ed25519:...

# ---- NEAR Intents 1Click ----
# optional partner JWT: without it 1Click adds 0.25% to every quote
ONECLICK_JWT=
# where swapped USDC lands: the payout rail's master Solana wallet address
SOLANA_USDC_RECIPIENT=

# ---- Payout rail (Fossapay) ----
# leave empty to simulate payouts (the service logs what it would send)
FOSSAPAY_API_KEY=
FOSSAPAY_API_URL=https://api-production.fossapay.com/api/v1
FOSSAPAY_WEBHOOK_SECRET=

# ---- Pricing ----
# your margin on top of the live rate and rail fees, in basis points (50 = 0.5%)
MARGIN_BPS=50
# smallest deposit that triggers a cash-out
MIN_CASHOUT_NEAR=0.1
# NEAR left in every deposit account for storage
DEPOSIT_RESERVE_NEAR=0.06

# ---- Auth (Privy) ----
# leave empty for demo mode: the frontend sends x-demo-email instead of a Privy token
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---- Service ----
PORT=8787
DB_PATH=./paya.db
POLL_MS=6000
# comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

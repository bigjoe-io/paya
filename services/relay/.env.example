# Mainnet only: NEAR Intents (1Click) and PAJ production have no testnet.
# Production: use a paid RPC (e.g. FastNEAR with an API key); every account is polled for deposits.
NEAR_RPC_URL=https://free.rpc.fastnear.com

# Paya's Solana wallet (USDC in transit, SOL for fees). Production: a paid RPC (Helius, QuickNode).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Rubic swap aggregator (ChangeNOW, SimpleSwap, The Change, ...). Free tier is 10 requests/min;
# ask Rubic (t.me/RubicPartnership) for a pro key and set it here to lift that.
RUBIC_API_KEY=
RUBIC_REFERRER=paya

# PAJ Cash business API key (production) — never commit the real value
PAJ_API_KEY=
PAJ_API_URL=https://api.paj.cash

# Safety switch. false = sign-in, banks, name lookup and quotes are real, but no PAJ order is
# created and no NEAR is sent (orders are simulated). true = REAL MONEY MOVES.
LIVE_ORDERS=false

# Paya's fee as % of the USDC amount (charged through PAJ's businessUSDCFee)
FEE_PERCENT=0.5

# Public https URL of this relay, for PAJ webhooks (optional; the relay also polls)
# PUBLIC_URL=https://relay.example.com

# ---- Accounts (required). Generate each with: openssl rand -hex 32 ----
# MASTER_SEED derives every user's NEAR address and key. It IS the custody:
# losing it locks users' NEAR, leaking it exposes it. Back it up offline (password manager + paper).
# Never change it after launch.
MASTER_SEED=
# Encrypts stored payout sessions
DATA_KEY=
# Signs app sessions (changing it signs everyone out)
SESSION_SECRET=

# Optional but recommended: a funded NEAR account that sends 0.01 NEAR to activate a new
# user's address before their first purchase. Fund with ~5 NEAR (≈500 activations).
# TREASURY_ACCOUNT_ID=paya-treasury.near
# TREASURY_PRIVATE_KEY=ed25519:...

# Auto cash-out threshold and the NEAR left in each address for fees
AUTO_MIN_NEAR=0.4
RESERVE_NEAR=0.02

PORT=8787
DB_PATH=./paya-data.json
BUYS_PATH=./paya-buys.json
USERS_PATH=./paya-users.json
DEPOSIT_POLL_MS=15000
POLL_MS=5000
CORS_ORIGINS=http://localhost:3000

# Admin API: shared secret for the admin app (server-to-server). Unset = admin API off.
# Generate: openssl rand -hex 32
ADMIN_TOKEN=

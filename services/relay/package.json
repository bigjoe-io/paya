{
  "name": "paya-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paya relay: watches deposit accounts, swaps NEAR to USDC via NEAR Intents, pays naira via the payout rail",
  "scripts": {
    "dev": "node --experimental-sqlite --watch --import tsx src/index.ts",
    "start": "node --experimental-sqlite --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}

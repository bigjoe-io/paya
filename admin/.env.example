# Copy to .env.local (local) or set in your host's environment (production).
# URL of the relay (server-to-server; never exposed to the browser)
RELAY_URL=http://localhost:8787
# Must equal ADMIN_TOKEN in services/relay/.env  (openssl rand -hex 32)
RELAY_ADMIN_TOKEN=
# Admin sign-in password, 12+ characters
ADMIN_PASSWORD=
# 32+ random characters (openssl rand -hex 32); rotating it signs everyone out
ADMIN_SESSION_SECRET=
